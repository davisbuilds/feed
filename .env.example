# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# Optional (OpenAI defaults shown)
# LLM_MODEL=gpt-5.6-luna
# LLM_REASONING_EFFORT=xhigh
# Gemini and Anthropic can instead use LLM_API_KEY with LLM_PROVIDER=gemini|anthropic.

# Email Configuration
RESEND_API_KEY=re_...
EMAIL_FROM=digest@yourdomain.com
EMAIL_TO=you@email.com

# Optional: Override defaults
# DIGEST_HOUR=7
# DIGEST_TIMEZONE=America/New_York
# LOG_LEVEL=INFO
